MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@YOUR-CLUSTER.mongodb.net/chavix?retryWrites=true&w=majority
# Nombre de la base de datos (si no está en la URI). Sin esto MongoDB usa "test".
MONGODB_DB=chavix
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-long-random-secret
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ADMIN_EMAILS=admin@example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Solo desarrollo: permite entrar sin Google con cualquier correo (ignorado en producción)
LOCAL_DEV_LOGIN=false
